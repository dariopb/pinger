{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/pinger.go",
            "env": {},
            "args": [ "--enableXterm", "--enableUpload", "--token=5555"
                //, "--grpcaddress=unix:///tmp/pinger.sock"
            ],
            "showLog": true
        },
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "purpose": ["debug-test"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--no-cov" }
          }
    ]
}